diff --git a/crates/sqll_parser/src/hint_check.rs b/crates/sqll_parser/src/hint_check.rs
new file mode 100644
index 0000000..60e873d
--- /dev/null
+++ b/crates/sqll_parser/src/hint_check.rs
@@ -0,0 +1,28 @@
+//! Hint check (scripts/s3/hint_check.py): counts of the terminator probes
+//! that the simple hint excludes.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static EXCLUSIONS: AtomicU64 = AtomicU64::new(0);
+static PROBE_MATCHES: AtomicU64 = AtomicU64::new(0);
+static PROBE_LIMITS: AtomicU64 = AtomicU64::new(0);
+
+pub fn record(probe_matched: bool, probe_hit_limit: bool) {
+    EXCLUSIONS.fetch_add(1, Ordering::Relaxed);
+    if probe_matched {
+        PROBE_MATCHES.fetch_add(1, Ordering::Relaxed);
+    }
+    if probe_hit_limit {
+        PROBE_LIMITS.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// The line that the check build writes to stderr after the parse.
+pub fn report() -> String {
+    format!(
+        "hint-check: exclusions={} probe_matches={} probe_limits={}",
+        EXCLUSIONS.load(Ordering::Relaxed),
+        PROBE_MATCHES.load(Ordering::Relaxed),
+        PROBE_LIMITS.load(Ordering::Relaxed)
+    )
+}
