#!/bin/sh
# Fail if third_party/sqlfluff has a change, or an untracked or ignored file.
# The tests and the suites must not change the submodule.
# Usage: scripts/check-submodule [WHEN]   (WHEN is for the message only)
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
changes=$(git -C "$root/third_party/sqlfluff" status --porcelain --ignored)
if [ -n "$changes" ]; then
    echo "error: third_party/sqlfluff is not clean${1:+ $1}:" >&2
    echo "$changes" >&2
    exit 1
fi
