#!/usr/bin/env python3
"""Find the pytest nodes outside test/cli/, test/rules/, and
test/core/config/ that read test/fixtures/config when they run.

scripts/s7-tests/inventory puts each such node in the S7 scope (group
config_fixtures), together with the nodes that name the folder in their
test source. A node "reads" a path if it opens the file or lists the folder
(the Python audit events "open", "os.listdir", and "os.scandir"). A stat of
a path is not a read.

Run it with the pinned sqlfluff and pytest that scripts/setup installs:

  .tools/sqlfluff-oracle/bin/python scripts/s7-tests/config-readers           # JSON to stdout
  .tools/sqlfluff-oracle/bin/python scripts/s7-tests/config-readers --write   # results/S7-tests/config-readers.json

It copies the submodule (no .git) to a temp folder and runs the sqlfluff
tests there, without the 3 scope folders (all their nodes are in scope).
Thus the run cannot change the submodule. It takes about 15 minutes.

Fail-closed checks: in the collection, pytest lists the folders
("os.scandir"). Another read in the collection, or a read outside the
collection and the tests, stops the script with exit code 1.
"""

import argparse
import json
import os
import shutil
import sys
import tempfile
from collections import Counter
from importlib.metadata import version
from pathlib import Path

sys.dont_write_bytecode = True

import pytest  # noqa: E402

REPO_ROOT = Path(__file__).resolve().parents[2]
SQLFLUFF_ROOT = REPO_ROOT / "third_party" / "sqlfluff"
RECORDED = REPO_ROOT / "results" / "S7-tests" / "config-readers.json"
FORMAT = 1
SKIPPED_FOLDERS = ["test/cli", "test/rules", "test/core/config"]
EVENTS = ("open", "os.listdir", "os.scandir")
OUTSIDE = "<outside a test>"
COLLECTION = "<collection>"


class Tracer:
    """A pytest plugin and an audit hook. It records the reads of the
    target folder for each node, and the outcome of each node."""

    def __init__(self, root: Path) -> None:
        self.root = str(root)
        self.target = os.path.join(self.root, "test", "fixtures", "config")
        self.current = OUTSIDE
        self.reads: dict[str, set[tuple[str, str]]] = {}
        self.outcomes: dict[str, str] = {}
        self.errors: dict[str, str] = {}

    def audit(self, event: str, args: tuple) -> None:
        if event not in EVENTS or not args:
            return
        path = args[0]
        if isinstance(path, bytes):
            path = os.fsdecode(path)
        if not isinstance(path, str | os.PathLike):
            return
        full = os.path.abspath(os.fspath(path))
        if full == self.target or full.startswith(self.target + os.sep):
            rel = os.path.relpath(full, self.root).replace(os.sep, "/")
            self.reads.setdefault(self.current, set()).add((event, rel))

    @pytest.hookimpl(wrapper=True)
    def pytest_collection(self, session):
        self.current = COLLECTION
        try:
            return (yield)
        finally:
            self.current = OUTSIDE

    @pytest.hookimpl(wrapper=True)
    def pytest_runtest_protocol(self, item, nextitem):
        self.current = item.nodeid
        try:
            return (yield)
        finally:
            self.current = OUTSIDE

    def pytest_runtest_logreport(self, report) -> None:
        if report.when == "call" or report.outcome != "passed":
            self.outcomes.setdefault(report.nodeid, report.outcome)

    def pytest_collectreport(self, report) -> None:
        if report.failed:
            self.errors[report.nodeid] = last_error_line(str(report.longrepr))


def last_error_line(text: str) -> str:
    """The last "E" line of a pytest error text, without the "E" mark."""
    lines = [x[1:].strip() for x in text.splitlines() if x.startswith("E ")]
    return lines[-1] if lines else text.strip().splitlines()[-1]


def run(source: Path, work: Path) -> Tracer:
    """Copy source to work, run its tests there, and return the trace."""
    shutil.copytree(source, work, ignore=shutil.ignore_patterns(".git"), symlinks=True)
    tracer = Tracer(work)
    sys.addaudithook(tracer.audit)
    os.chdir(work)
    args = ["-q", "-p", "no:cacheprovider", "--continue-on-collection-errors"]
    args += [f"--ignore={f}" for f in SKIPPED_FOLDERS]
    sys.stdout.flush()
    saved = os.dup(1)
    os.dup2(2, 1)
    try:
        pytest.main([*args, "test"], plugins=[tracer])
    finally:
        sys.stdout.flush()
        os.dup2(saved, 1)
        os.close(saved)
    return tracer


def report(tracer: Tracer) -> tuple[dict, list[str]]:
    problems = []
    reads = dict(tracer.reads)
    outside = reads.pop(OUTSIDE, set())
    if outside:
        problems.append(
            f"a read outside the collection and the tests: {sorted(outside)}"
        )
    collection = reads.pop(COLLECTION, set())
    other = sorted(r for r in collection if r[0] != "os.scandir")
    if other:
        problems.append(f"a read in the collection that is not a folder list: {other}")
    out = {
        "format": FORMAT,
        "sqlfluff": version("sqlfluff"),
        "pytest": pytest.__version__,
        "skipped_folders": SKIPPED_FOLDERS,
        "outcomes": dict(sorted(Counter(tracer.outcomes.values()).items())),
        "collection_errors": dict(sorted(tracer.errors.items())),
        "failed": sorted(n for n, o in tracer.outcomes.items() if o == "failed"),
        "collection_lists": sorted({p for _, p in collection}),
        "readers": {n: sorted({p for _, p in r}) for n, r in sorted(reads.items())},
    }
    return out, problems


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="config-readers")
    parser.add_argument("--write", action="store_true", help=f"write {RECORDED}")
    parser.add_argument(
        "--root",
        type=Path,
        default=SQLFLUFF_ROOT,
        help="a sqlfluff checkout (for the unit tests; not with --write)",
    )
    args = parser.parse_args(argv)
    if args.write and args.root != SQLFLUFF_ROOT:
        parser.error("--write needs the pinned submodule")
    with tempfile.TemporaryDirectory(prefix="s7-config-readers-") as tmp:
        tracer = run(args.root.resolve(), Path(tmp) / "sqlfluff")
        os.chdir(REPO_ROOT)
        out, problems = report(tracer)
    for p in problems:
        print(f"error: {p}", file=sys.stderr)
    print(
        f"outcomes: {out['outcomes']}; readers: {len(out['readers'])}", file=sys.stderr
    )
    text = json.dumps(out, indent=1) + "\n"
    if problems:
        return 1
    if args.write:
        RECORDED.write_text(text, "utf8")
        print(f"wrote {RECORDED.relative_to(REPO_ROOT)}", file=sys.stderr)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
