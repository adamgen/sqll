def rust_version() -> str | None:
    try:
        return version("sqlfluffrs")
    except PackageNotFoundError:
        return None


def first_line(exc: BaseException) -> str:
    lines = str(exc).splitlines()
    return f"{type(exc).__name__}: {lines[0] if lines else ''}"


def plain(value):
    """value as JSON data; a value that JSON cannot hold becomes its repr."""
    return json.loads(json.dumps(value, default=lambda v: f"<{v!r}>"))


def read_tree(folder: str) -> dict[str, str]:
    """Each file of a folder as UTF-8 text (ValueError if one is not)."""
    out = {}
    for path in sorted(Path(folder).rglob("*")):
        if path.is_file():
            try:
                out[path.relative_to(folder).as_posix()] = path.read_bytes().decode()
            except UnicodeDecodeError as exc:
                raise ValueError(f"the file {path.name} is not UTF-8 text") from exc
    return out


class Tracer:
    """The calls of each node. node is the current node id."""

    def __init__(self, root: Path) -> None:
        self.root = root
        self.node = s7trace.OUTSIDE
        self.active: list[str] = []
        # For each active call: the list of its inner calls, or None.
        self.inner: list[list | None] = []
        self.records: dict[str, dict] = {}
        self.tmp: dict[str, list[str]] = {}
        self._reference = None
        # The errors of the watched functions in the CLI run of a proof.
        self.proof_errors: list[dict[str, str]] = []
        # The original CliRunner.invoke (install sets it).
        self.invoke = None
        # The templater calls of a CLI run of the templater map.
        self.proof_calls: list[dict] | None = None

    def add_tmp(self, folder) -> None:
        """A temporary folder of the current node."""
        self.tmp.setdefault(self.node, []).append(os.path.abspath(os.fspath(folder)))

    def tmp_of(self, text: str) -> tuple[str, str | None]:
        """(text with {tmp}, the folder) for a path in a temporary folder of
        the node; (text, None) for each other text. ValueError if the text
        has a folder in another place."""
        for folder in sorted(self.tmp.get(self.node, []), key=len, reverse=True):
            if text == folder or text.startswith(folder + os.sep):
                return TMP_MARK + text[len(folder) :], folder
            if folder in text:
                raise ValueError(f"the argument {text!r} has a temporary folder in it")
        return text, None

    def reference(self) -> dict:
        """The snapshot of the default config (FluffConfig with no input)."""
        if self._reference is None:
            from sqlfluff.core.config import FluffConfig

            self._reference = s7config.snapshot(
                FluffConfig(require_dialect=False)._configs
            )
        return self._reference

    def config_model(self, config) -> dict:
        """The .sqlfluff text of a config and its proof: the keys that the
        CLI config from that file in an empty folder does not give."""
        from sqlfluff.core.config import FluffConfig

        effective = s7config.snapshot(config._configs)
        try:
            text = s7config.config_text(effective, self.reference())
        except s7config.ConfigMapError as exc:
            return {"config_file": {"error": str(exc)}, "config_proof": None}
        folder = MKDTEMP(prefix="s7-config-")
        old = os.getcwd()
        try:
            if text:
                Path(folder, s7config.CONFIG_FILE).write_text(text, encoding="utf8")
            os.chdir(folder)
            loaded = FluffConfig.from_root(require_dialect=False)
        finally:
            os.chdir(old)
            shutil.rmtree(folder)
        proof = s7config.differences(s7config.snapshot(loaded._configs), effective)
        return {"config_file": {"text": text}, "config_proof": proof}

    def overrides_model(self, config) -> dict:
        """The overrides of a config and the keys that
        FluffConfig(overrides=<them>) does not give."""
        from sqlfluff.core.config import FluffConfig

        overrides = dict(config._overrides or {})
        other = FluffConfig(overrides=overrides or None, require_dialect=False)
        return {
            "values": plain(overrides),
            "extra_config_path": config._extra_config_path,
            "ignore_local_config": config._ignore_local_config,
            "proof": s7config.differences(
                s7config.snapshot(other._configs), s7config.snapshot(config._configs)
            ),
        }

    def bucket(self) -> dict:
        return self.records.setdefault(
            self.node,
            {"calls": [], "untraced": [], "untraced_linter": [], "forks": 0},
        )

    def path(self, value) -> str:
        """A path or argument; the root folder of sqlfluff becomes
        {sqlfluff}."""
        text = os.fspath(value)
        root = str(self.root)
        if text == root or text.startswith(root + os.sep):
            text = ROOT_MARK + text[len(root) :]
        return text

    def cwd(self) -> str:
        return self.path(os.getcwd())

    def traced(self, kind: str, inputs, outputs, nested_in: tuple[str, ...] = ()):
        """Wrap fn: record each outermost call with its inputs and outputs.

        inputs(context, *args, **kwargs) and outputs(context, result) share
        the dict context. If inputs sets context["nest"], the call records
        its inner calls of a kind whose nested_in has the kind of the call.
        A call inside a traced call is part of it, and is not recorded alone.
        """

        def wrap(fn):
            @functools.wraps(fn)
            def wrapper(*args, **kwargs):
                if self.active:
                    outer = self.active[0] if len(self.active) == 1 else None
                    sink = self.inner[-1] if outer in nested_in else None
                    if sink is None:
                        return fn(*args, **kwargs)
                else:
                    sink = self.bucket()["calls"]
                call = {"kind": kind}
                context: dict = {}
                try:
                    call["inputs"] = inputs(context, *args, **kwargs)
                except Exception as exc:
                    call["inputs_error"] = first_line(exc)
                self.active.append(kind)
                self.inner.append([] if context.get("nest") else None)
                try:
                    result = fn(*args, **kwargs)
                except BaseException as exc:
                    call["raised"] = first_line(exc)
                    raise
                else:
                    try:
                        call["outputs"] = outputs(context, result)
                    except Exception as exc:
                        call["outputs_error"] = first_line(exc)
                    return result
                finally:
                    self.active.pop()
                    inner = self.inner.pop()
                    if inner is not None:
                        call["inner"] = inner
                    sink.append(plain(call))

            return wrapper

        return wrap

    def sentinel(
        self,
        kinds: tuple[str, ...],
        what: str,
        applies=lambda *a, **k: True,
        key="untraced",
    ):
        """Wrap fn: record a run outside each traced call of these kinds."""

        def wrap(fn):
            @functools.wraps(fn)
            def wrapper(*args, **kwargs):
                covered = set(kinds) | {PROOF}
                if not covered & set(self.active) and applies(*args, **kwargs):
                    self.bucket()[key].append(what)
                return fn(*args, **kwargs)

            return wrapper

        return wrap

    def errors(self, function: str, describe):
        """Wrap fn: record an error call if fn raises outside each traced call.

        describe(*args, **kwargs) gives the inputs of the call: the function,
        and either the CLI input ("cli_input": {"files": ..., "options": ...})
        or the reason why the trace has none ("no_cli_input"). In the CLI run
        of a proof, an error of fn is a proof error, not a call.
        """

        def wrap(fn):
            @functools.wraps(fn)
            def wrapper(*args, **kwargs):
                proof = self.active == [PROOF]
                if self.active and not proof:
                    return fn(*args, **kwargs)
                try:
                    with self.scope(CONSTRUCT):
                        return fn(*args, **kwargs)
                except Exception as exc:
                    if proof:
                        error = {"function": function, "error": first_line(exc)}
                        self.proof_errors.append(error)
                    else:
                        self.error_call(function, describe, exc, args, kwargs)
                    raise

            return wrapper

        return wrap

    @contextlib.contextmanager
    def scope(self, mark: str):
        """A mark on self.active: no call in it is a traced call."""
        self.active.append(mark)
        self.inner.append(None)
        try:
            yield
        finally:
            self.active.pop()
            self.inner.pop()

    def error_call(self, function: str, describe, exc, args, kwargs) -> None:
        call: dict = {"kind": "error", "error": first_line(exc)}
        try:
            inputs = {"function": function, **describe(*args, **kwargs)}
            inputs["cwd"] = self.cwd()
            call["inputs"] = inputs
            cli_input = inputs.get("cli_input")
            if cli_input is not None:
                call["cli"] = self.cli_proof(cli_input)
        except Exception as error:
            call["inputs_error"] = first_line(error)
        self.bucket()["calls"].append(plain(call))

    def cli_proof(self, cli_input: dict) -> dict:
        """Run "lint [options] -" with an empty stdin in a new folder with the
        files, in process. The outputs, and the errors of the watched
        functions in the run."""
        from sqlfluff.cli import commands

        files = cli_input.get("files", {})
        argv = [*cli_input.get("options", []), "-"]
        folder = MKDTEMP(prefix="s7-error-")
        old = os.getcwd()
        self.proof_errors = []
        state = cli_state()
        try:
            for name, text in files.items():
                Path(folder, name).write_text(text, encoding="utf8")
            os.chdir(folder)
            with self.scope(PROOF):
                result = self.invoke(CliRunner(), commands.lint, argv, input="")
            os.chdir(old)
            out = {
                "argv": ["lint", *argv],
                "stdin": "",
                "files": files,
                "exit_code": result.exit_code,
                "stdout": result.stdout.replace(folder, TMP_MARK),
                "stderr": result.stderr.replace(folder, TMP_MARK),
                "files_after": read_tree(folder),
                "errors": list(self.proof_errors),
            }
            if result.exception is not None and not isinstance(
                result.exception, SystemExit
            ):
                out["exception"] = first_line(result.exception)
            return out
        finally:
            os.chdir(old)
            self.proof_errors = []
            shutil.rmtree(folder)
            state()


def cli_state():
    """Save the process state that a CLI run changes outside its result: the
    sqlfluff loggers (the CLI sets propagate=False on "sqlfluff", adds a log
    handler, and sets levels) and the globals of colorama (colorama.init).
    The returned function restores them, so the test does not see the CLI
    run of a proof (for example caplog sees the sqlfluff log records)."""
    import logging

    import colorama.initialise as colorama_state

    manager = logging.Logger.manager
    loggers = {
        name: (log.propagate, log.level, log.disabled, list(log.handlers))
        for name, log in [("sqlfluff", logging.getLogger("sqlfluff"))]
        + [
            (name, log)
            for name, log in list(manager.loggerDict.items())
            if name.startswith("sqlfluff.") and isinstance(log, logging.Logger)
        ]
    }
    names = ("orig_stdout", "orig_stderr", "wrapped_stdout", "wrapped_stderr")
    streams = {name: getattr(colorama_state, name, None) for name in names}
    atexit_done = getattr(colorama_state, "atexit_done", False)

    def restore() -> None:
        for name, log in list(manager.loggerDict.items()):
            if not (name == "sqlfluff" or name.startswith("sqlfluff.")):
                continue
            if not isinstance(log, logging.Logger):
                continue
            propagate, level, disabled, handlers = loggers.get(
                name, (True, logging.NOTSET, False, [])
            )
            log.propagate, log.disabled = propagate, disabled
            log.setLevel(level)
            log.handlers[:] = handlers
        for name, value in streams.items():
            setattr(colorama_state, name, value)
        if not atexit_done and getattr(colorama_state, "atexit_done", False):
            atexit.unregister(colorama_state.reset_all)
            colorama_state.atexit_done = False

    return restore


def _is_sqlfluff(command) -> bool:
    module = getattr(getattr(command, "callback", None), "__module__", "") or ""
    return module == "sqlfluff" or module.startswith("sqlfluff.")


def file_outputs(linted_file) -> dict:
    """The lint records of a LintedFile as the CLI gives them (LintedDir), and
    the counts that give the exit codes of the lint and fix commands."""
    from sqlfluff.core.errors import SQLLintError
    from sqlfluff.core.linter.linted_dir import LintedDir
    from sqlfluff.core.linter.linted_file import TMP_PRS_ERROR_TYPES

    folder = LintedDir(linted_file.path)
    folder.add(linted_file)
    return {
        "records": [
            {k: v for k, v in r.items() if k not in VOLATILE_RECORD_KEYS}
            for r in folder.as_records()
        ],
        "violations": linted_file.num_violations(),
        "tmp_prs": linted_file.num_violations(
            types=TMP_PRS_ERROR_TYPES, filter_ignore=False, filter_warning=False
        ),
        "fixable": linted_file.num_violations(types=SQLLintError, fixable=True),
        "unfixable": linted_file.num_violations(types=SQLLintError, fixable=False),
    }


def install(tracer: Tracer) -> None:
    """Patch the CLI runner, the simple API, the Linter, FluffConfig, the
    RuleSet, the test helpers, and tempfile.mkdtemp."""
    import sqlfluff
    import sqlfluff.api
    import sqlfluff.api.simple as simple
    import sqlfluff.cli.commands as commands
    import sqlfluff.utils.testing.rules as testing_rules
    from sqlfluff.core.config import FluffConfig
    from sqlfluff.core.config.loader import load_config_at_path
    from sqlfluff.core.helpers.dict import nested_combine
    from sqlfluff.core.linter import Linter
    from sqlfluff.core.rules.base import RuleSet

    # The temporary folders of the nodes.
    @functools.wraps(MKDTEMP)
    def mkdtemp(*args, **kwargs):
        folder = MKDTEMP(*args, **kwargs)
        tracer.add_tmp(folder)
        return folder

    tempfile.mkdtemp = mkdtemp

    def tmp_inputs(context, folder: str, others: list[str]) -> dict:
        """The files of a temporary folder before a CLI call, the sqlfluff
        config of the folders above it, and the other arguments that are
        paths in the working folder. For a call in the sqlfluff root with a
        config or ignore file in the folder, a copy of the folder for the
        run of the call in the folder (cwd_outputs)."""
        context["tmp"] = folder
        outer = [load_config_at_path(str(p)) for p in reversed(Path(folder).parents)]
        files = read_tree(folder)
        if tracer.cwd() == ROOT_MARK and any(
            Path(name).name in CONFIG_FILES for name in files
        ):
            copy = MKDTEMP(prefix="s7-cwd-")
            atexit.register(shutil.rmtree, copy, True)
            shutil.copytree(folder, copy, dirs_exist_ok=True)
            context["copy"] = copy
        return {
            "files": files,
            "outer_config": plain(nested_combine({}, *outer)),
            "cwd_paths": [
                a for a in others if not a.startswith("-") and os.path.exists(a)
            ],
        }

    def cwd_outputs(context) -> dict:
        """Run the CLI call again in the copy of its temporary folder, with
        the copy as the working folder, in process (the case runs so). The
        outputs, with the copy as {tmp}. The oracle maps a call in the
        sqlfluff root with a config or ignore file in the folder only if
        these are the outputs of the call."""
        folder, copy = context["tmp"], context["copy"]
        argv = [os.fspath(a) for a in context["argv"]]
        argv = [
            copy + a[len(folder) :]
            if a == folder or a.startswith(folder + os.sep)
            else a
            for a in argv
        ]
        old = os.getcwd()
        state = cli_state()
        try:
            os.chdir(copy)
            with tracer.scope(PROOF):
                result = tracer.invoke(
                    context["runner"], context["cli"], argv, input=context["stdin"]
                )
            os.chdir(old)
            out = {
                "exit_code": result.exit_code,
                "stdout": result.stdout.replace(copy, TMP_MARK),
                "stderr": result.stderr.replace(copy, TMP_MARK),
                "files": read_tree(copy),
            }
            if result.exception is not None and not isinstance(
                result.exception, SystemExit
            ):
                out["exception"] = first_line(result.exception)
            return out
        finally:
            os.chdir(old)
            shutil.rmtree(copy)
            state()

    # CLI.
    invoke_sig = inspect.signature(CliRunner.invoke)

    def cli_inputs(context, runner, *args, **kwargs):
        bound = invoke_sig.bind(runner, *args, **kwargs)
        cli = bound.arguments["cli"]
        argv = bound.arguments.get("args") or []
        if isinstance(argv, str):
            argv = shlex.split(argv)
        unsupported = []
        texts = []
        others = []
        folders = set()
        for arg in argv:
            if isinstance(arg, str | os.PathLike):
                try:
                    text, folder = tracer.tmp_of(tracer.path(arg))
                except ValueError as exc:
                    unsupported.append(str(exc))
                    text, folder = tracer.path(arg), None
                texts.append(text)
                if folder is not None:
                    folders.add(folder)
                else:
                    others.append(os.fspath(arg))
            else:
                unsupported.append(f"argument {arg!r} is not a string")
                texts.append(repr(arg))
        cwd = tracer.cwd()
        cwd_text, cwd_folder = tracer.tmp_of(os.getcwd())
        if cwd_folder is not None:
            if cwd_text != TMP_MARK:
                unsupported.append("the working folder is in a temporary folder")
            folders.add(cwd_folder)
            cwd = cwd_text
        context.update(
            runner=runner, cli=cli, argv=list(argv), stdin=bound.arguments.get("input")
        )
        is_group = isinstance(cli, click.Group) and cli is commands.cli
        if not is_group:
            texts = [cli.name or "", *texts]
        stdin = bound.arguments.get("input")
        if isinstance(stdin, bytes):
            stdin = stdin.decode("utf8")
        elif stdin is not None and not isinstance(stdin, str):
            unsupported.append(f"stdin of type {type(stdin).__name__}")
            stdin = None
        for key in ("env", "extra"):
            if bound.arguments.get(key):
                unsupported.append(f"CliRunner.invoke {key}: {bound.arguments[key]!r}")
        if runner.env:
            unsupported.append(f"CliRunner env: {runner.env!r}")
        if not _is_sqlfluff(cli):
            unsupported.append(f"command {cli.name!r} is not a sqlfluff command")
        data = {
            "argv": texts,
            "stdin": stdin,
            "cwd": cwd,
            "unsupported": unsupported,
        }
        if len(folders) > 1:
            unsupported.append(f"{len(folders)} temporary folders")
        elif folders:
            data["tmp"] = tmp_inputs(context, folders.pop(), others)
        return data

    def cli_outputs(context, result):
        out = {
            "exit_code": result.exit_code,
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
        if result.exception is not None and not isinstance(
            result.exception, SystemExit
        ):
            out["exception"] = first_line(result.exception)
        folder = context.get("tmp")
        if folder is not None:
            for stream in ("stdout", "stderr"):
                out[stream] = out[stream].replace(folder, TMP_MARK)
            out["files"] = read_tree(folder)
        if "copy" in context:
            try:
                out["cwd_outputs"] = cwd_outputs(context)
            except Exception as exc:
                out["cwd_outputs"] = {"error": first_line(exc)}
        return out

    tracer.invoke = CliRunner.invoke
    CliRunner.invoke = tracer.traced("cli", cli_inputs, cli_outputs)(CliRunner.invoke)
    click.core.Command.main = tracer.sentinel(
        ("cli", PROOF),
        "a sqlfluff CLI command (Command.main)",
        lambda command, *a, **k: _is_sqlfluff(command),
    )(click.core.Command.main)
    commands.get_config = tracer.sentinel(
        ("cli", PROOF), "the CLI config (get_config)"
    )(commands.get_config)

    # The simple API.
    def config_source(config) -> object:
        if config is None:
            return None
        return getattr(config, "_s7_source", {"method": "<unknown>"})

    def api(name: str):
        original = getattr(simple, name)
        sig = inspect.signature(original)

        def inputs(context, *args, **kwargs):
            bound = sig.bind(*args, **kwargs)
            bound.apply_defaults()
            data = dict(bound.arguments)
            # With a config, the call records its Linter string call.
            context["nest"] = data.get("config") is not None
            data["config"] = config_source(data.get("config"))
            return {"function": name, **data, "cwd": tracer.cwd()}

        return tracer.traced("api", inputs, lambda context, r: plain(r))(original)

    for name in ("lint", "fix", "parse"):
        wrapped = api(name)
        for module in (simple, sqlfluff.api, sqlfluff):
            setattr(module, name, wrapped)
    simple.get_simple_config = tracer.sentinel(
        ("api",), "the simple-API config (get_simple_config)"
    )(simple.get_simple_config)

    # FluffConfig: remember how the test made each config.
    init = FluffConfig.__init__
    init_sig = inspect.signature(init)

    @functools.wraps(init)
    def config_init(self, *args, **kwargs):
        bound = init_sig.bind(self, *args, **kwargs)
        data = {k: v for k, v in bound.arguments.items() if k != "self"}
        self._s7_source = plain({"method": "FluffConfig", "args": data})
        init(self, *args, **kwargs)

    def no_config(*args, **kwargs) -> dict:
        return {
            "no_cli_input": "the FluffConfig construction failed: the trace has"
            " no config to give to the CLI"
        }

    FluffConfig.__init__ = tracer.errors("FluffConfig", no_config)(config_init)
    for name in ("from_path", "from_root", "from_kwargs", "from_string"):
        method = getattr(FluffConfig, name).__func__
        sig = inspect.signature(method)

        def tagged(cls, *args, _method=method, _sig=sig, _name=name, **kwargs):
            bound = _sig.bind(cls, *args, **kwargs)
            data = {k: v for k, v in bound.arguments.items() if k != "cls"}
            if "path" in data:
                data["path"] = tracer.path(data["path"])
            config = _method(cls, *args, **kwargs)
            config._s7_source = plain({"method": _name, "args": data})
            return config

        watched = tracer.errors(f"FluffConfig.{name}", no_config)(tagged)
        setattr(FluffConfig, name, classmethod(functools.wraps(method)(watched)))

    # The Linter path methods.
    linter_init = Linter.__init__
    linter_sig = inspect.signature(linter_init)

    @functools.wraps(linter_init)
    def new_linter_init(self, *args, **kwargs):
        bound = linter_sig.bind(self, *args, **kwargs)
        data = {k: v for k, v in bound.arguments.items() if k != "self"}
        data["config"] = config_source(data.get("config"))
        self._s7_init = plain(data)
        linter_init(self, *args, **kwargs)
        if data["config"] is None and any(data.get(k) for k in LINTER_KWARGS):
            # FluffConfig.from_kwargs made the config: the trace proves that
            # it is FluffConfig(overrides=<its overrides>).
            self._s7_init["kwargs_config"] = tracer.overrides_model(self.config)
        # The config when the Linter took its dialect and templater.
        self._s7_config = s7config.snapshot(self.config._configs)

    def config_input(config) -> dict:
        """The config model of a config, and its CLI input: a .sqlfluff file
        (only if the model maps it and the CLI loads it as the same
        config)."""
        model = tracer.config_model(config)
        if "error" in model["config_file"]:
            reason = f"the config model: {model['config_file']['error']}"
        elif model["config_proof"]:
            reason = f"the config model: the keys {model['config_proof']} differ"
        else:
            text = model["config_file"]["text"]
            files = {s7config.CONFIG_FILE: text} if text else {}
            return {**model, "cli_input": {"files": files}}
        return {**model, "no_cli_input": reason}

    def linter_error(self, *args, **kwargs) -> dict:
        """A Linter construction that failed: its config or its arguments as
        the CLI input."""
        bound = linter_sig.bind(self, *args, **kwargs)
        data = {k: v for k, v in bound.arguments.items() if k != "self"}
        config = data.pop("config", None)
        out = {"linter": plain({**data, "config": config_source(config)})}
        others = sorted(k for k, v in data.items() if k not in LINTER_KWARGS and v)
        if others:
            return {**out, "no_cli_input": f"the Linter arguments {others}"}
        if config is not None:
            if any(data.get(k) for k in LINTER_KWARGS):
                return {**out, "no_cli_input": "a config and Linter arguments"}
            return {**out, **config_input(config)}
        options = []
        for key in LINTER_KWARGS:
            value = data.get(key)
            if value:
                text = value if key == "dialect" else ",".join(value)
                options += ["--" + key.replace("_", "-"), text]
        return {**out, "cli_input": {"options": options}}

    Linter.__init__ = tracer.errors("Linter", linter_error)(new_linter_init)

    # A rule pack of a config (RuleSet.get_rulepack) outside each traced
    # call: an error is an error call, with the config as the CLI input.
    def rulepack_error(self, config, *args, **kwargs) -> dict:
        return config_input(config)

    RuleSet.get_rulepack = tracer.errors("RuleSet.get_rulepack", rulepack_error)(
        RuleSet.get_rulepack
    )

    def path_method(name: str):
        original = getattr(Linter, name)
        sig = inspect.signature(original)

        def inputs(context, self, *args, **kwargs):
            bound = sig.bind(self, *args, **kwargs)
            data = {k: v for k, v in bound.arguments.items() if k != "self"}
            paths = data.pop("paths", None) or [data.pop("path", None)]
            out = {
                "method": name,
                "paths": [tracer.path(p) for p in paths],
                "options": data,
                "linter": getattr(self, "_s7_init", None),
                "cwd": tracer.cwd(),
            }
            source = (out["linter"] or {}).get("config") or {}
            if source.get("method") != "from_path":
                out["overrides"] = tracer.overrides_model(self.config)
            return out

        def outputs(context, result):
            records = [
                {k: v for k, v in r.items() if k not in VOLATILE_RECORD_KEYS}
                for r in result.as_records()
            ]
            if name == "lint_path":
                violations = result.stats()["violations"]
            else:
                violations = result.stats(1, 0)["violations"]
            # The exit code of the lint command for this result
            # (sqlfluff.cli.commands.lint: LintingResult.stats).
            return {"records": records, "exit_code": 1 if violations > 0 else 0}

        return tracer.traced("linter", inputs, outputs, nested_in=("helper",))(original)

    Linter.lint_path = path_method("lint_path")
    Linter.lint_paths = path_method("lint_paths")

    # The Linter string methods.
    def string_method(name: str):
        original = getattr(Linter, name)
        sig = inspect.signature(original)
        text_arg = "in_str" if name == "lint_string" else "string"

        def inputs(context, self, *args, **kwargs):
            bound = sig.bind(self, *args, **kwargs)
            bound.apply_defaults()
            data = {k: v for k, v in bound.arguments.items() if k != "self"}
            sql = data.pop(text_arg)
            config = data.get("config")
            if config is not None:
                data["config"] = config_source(config)
            context.update(
                linter=self,
                sql=sql,
                fname=data["fname"],
                fix=bool(data["fix"]),
                config=config,
            )
            current = s7config.snapshot(self.config._configs)
            return {
                "method": name,
                "sql": sql,
                "options": data,
                "linter": getattr(self, "_s7_init", None),
                "config_changed": current != getattr(self, "_s7_config", current),
                "cwd": tracer.cwd(),
                **tracer.config_model(config or self.config),
            }

        def outputs(context, result):
            if name == "lint_string":
                linted = result
            else:
                files = [f for path in result.paths for f in path.files]
                if len(files) != 1:
                    raise ValueError(f"{len(files)} linted files, not 1")
                linted = files[0]
            out = file_outputs(linted)
            if context["fix"]:
                out["fixed"] = linted.fix_string()[0]
                # The violations of a lint with no fix, as the lint command
                # gives them. The oracle maps the call only if they are the
                # same violations.
                options = {"fname": context["fname"]}
                if name == "lint_string":
                    options["config"] = context["config"]
                out["lint"] = file_outputs(
                    context["linter"].lint_string(context["sql"], **options)
                )
            return out

        return tracer.traced("linter_string", inputs, outputs, nested_in=("api",))(
            original
        )

    Linter.lint_string = string_method("lint_string")
    Linter.lint_string_wrapped = string_method("lint_string_wrapped")

    # The test helpers: each call records its inner Linter calls. A test
    # module imports a helper after this patch (in the collection).
    def helper(name: str):
        original = getattr(testing_rules, name)
        sig = inspect.signature(original)

        def inputs(context, *args, **kwargs):
            bound = sig.bind(*args, **kwargs)
            bound.apply_defaults()
            data = dict(bound.arguments)
            context["nest"] = True
            if "fluff_config" in data:
                data["fluff_config"] = config_source(data["fluff_config"])
            if "fpath" in data:
                data["fpath"] = tracer.path(data["fpath"])
            return {"function": name, "args": data, "cwd": tracer.cwd()}

        return tracer.traced("helper", inputs, lambda context, r: plain(r))(original)

    for name in HELPERS:
        setattr(testing_rules, name, helper(name))

    # A Linter render or parse outside each traced call (for example
    # Linter.parse_string): the trace does not map it.
    kinds = ("cli", "api", "linter", "linter_string", "helper", PROOF)
    Linter.render_string = tracer.sentinel(
        kinds, "a Linter render (Linter.render_string)", key="untraced_linter"
    )(Linter.render_string)
    parse_rendered = Linter.__dict__["parse_rendered"].__func__
    Linter.parse_rendered = classmethod(
        tracer.sentinel(
            kinds, "a Linter parse (Linter.parse_rendered)", key="untraced_linter"
        )(parse_rendered)
    )


def templated_file_data(templated) -> dict:
    """The parts of a TemplatedFile that the templater gives (not fname)."""
    return plain(
        {
            "source_str": templated.source_str,
            "templated_str": templated.templated_str,
            "sliced_file": [
                [
                    s.slice_type,
                    [s.source_slice.start, s.source_slice.stop],
                    [s.templated_slice.start, s.templated_slice.stop],
                ]
                for s in templated.sliced_file
            ],
            "raw_sliced": [list(s) for s in templated.raw_sliced],
        }
    )


def error_text(exc: BaseException, fname) -> str:
    """The text of an error with the file name as <fname>: the call and the
    CLI give other file names."""
    desc = getattr(exc, "desc", None)
    text = desc() if callable(desc) else str(exc)
    return f"{type(exc).__name__}: {text}".replace(repr(fname), "<fname>")


def violation_texts(violations) -> list[str]:
    return [f"{type(v).__name__}: {v.desc()}" for v in violations]


def _words(text: str) -> str:
    return " ".join(text.split())


def templater_proof(cls, result, error, fname, runs, skip=False) -> list[str]:
    """The differences between the result of the call (result, or error)
    and the templater call of each CLI run (runs: (outputs, calls)).

    skip: the call raised SQLFluffSkipFile (large_file_check). The CLI skips
    the file before it calls the templater: the run must have no templater
    call and its stderr must have the text of the error, with the file name
    of the case."""
    out = []
    for run, calls in runs:
        where = " ".join(run["argv"])
        if skip:
            text = str(error).replace(repr(fname), repr(TEMPLATER_SQL))
            if calls:
                out.append(f"{where}: {len(calls)} templater calls, not 0")
            if _words(text) not in _words(run["stderr"]):
                out.append(f"{where}: the stderr does not have {text!r}")
            continue
        if len(calls) != 1:
            out.append(f"{where}: {len(calls)} templater calls, not 1")
            continue
        call = calls[0]
        if call["class"] is not cls:
            out.append(f"{where}: the templater {call['class'].__name__}")
            continue
        if error is not None:
            if "error" not in call:
                out.append(f"{where}: the call raised, the CLI templater did not")
            elif error_text(error, fname) != error_text(call["error"], call["fname"]):
                out.append(
                    f"{where}: the error {error_text(call['error'], call['fname'])!r},"
                    f" not {error_text(error, fname)!r}"
                )
            continue
        if "error" in call:
            out.append(f"{where}: the CLI templater raised {call['error']!r}")
            continue
        got, want = call["result"], result
        for key, value in templated_file_data(want[0]).items():
            if templated_file_data(got[0])[key] != value:
                out.append(f"{where}: the {key} of the templated file is different")
        if violation_texts(got[1]) != violation_texts(want[1]):
            out.append(f"{where}: the templater violations are different")
    return out


def install_templaters(tracer: Tracer) -> None:
    """Trace the process() calls of the templaters (--templaters)."""
    import sqlfluff.cli.commands as commands
    from sqlfluff.core.config import FluffConfig
    from sqlfluff.core.config.loader import load_config_at_path
    from sqlfluff.core.errors import SQLFluffSkipFile, SQLTemplaterError
    from sqlfluff.core.helpers.dict import nested_combine
    from sqlfluff.core.templaters import (
        JinjaTemplater,
        PlaceholderTemplater,
        PythonTemplater,
        RawTemplater,
    )

    def config_model(name: str, context, config) -> tuple[dict, list[str]]:
        """The .sqlfluff text of the case, and the inputs that the map does
        not know."""
        unsupported = []
        source = None if config is None else getattr(config, "_s7_source", None)
        if config is None:
            effective = json.loads(json.dumps(tracer.reference()))
            effective["core"]["dialect"] = NO_CONFIG_DIALECT
        else:
            if not isinstance(config, FluffConfig) or source is None:
                unsupported.append(f"a config that is not a FluffConfig: {config!r}")
            elif source.get("method") != "FluffConfig" or set(source["args"]) - {
                "overrides"
            }:
                unsupported.append(
                    f"a config from {source}; the map knows only"
                    " FluffConfig(overrides=...)"
                )
            effective = s7config.snapshot(config._configs)
        try:
            json.dumps(context, allow_nan=False)
        except (TypeError, ValueError):
            unsupported.append(f"a context value that is not a literal: {context!r}")
            return {"error": "the context is not a literal"}, unsupported
        try:
            text = s7config.templater_text(name, context, effective, tracer.reference())
        except s7config.ConfigMapError as exc:
            return {"error": str(exc)}, unsupported
        return {"text": text}, unsupported

    def run_case(argv: list[str], files: dict[str, str]) -> tuple[dict, list[dict]]:
        """Run one CLI case in a new folder, as the runner does. Return its
        outputs and the templater calls of the run."""
        folder = MKDTEMP(prefix="s6-case-")
        for name, text in files.items():
            Path(folder, name).write_bytes(text.encode("utf8"))
        old = os.getcwd()
        tracer.proof_calls = []
        # The error wrapper records the errors of the watched functions in
        # a proof run (Tracer.errors); the templater proof does not use them.
        tracer.proof_errors = []
        # The CLI run changes the sqlfluff loggers and colorama (cli_state);
        # restore them, as Tracer.cli_proof does, so the test does not see
        # the run.
        state = cli_state()
        try:
            os.chdir(folder)
            with tracer.scope(PROOF):
                result = CliRunner().invoke(commands.cli, argv)
        finally:
            os.chdir(old)
            calls, tracer.proof_calls = tracer.proof_calls, None
            tracer.proof_errors = []
            state()
        out = {
            "argv": argv,
            "exit_code": result.exit_code,
            "stdout": result.stdout.replace(folder, TMP_MARK),
            "stderr": result.stderr.replace(folder, TMP_MARK),
        }
        exc = result.exception
        if exc is not None and not isinstance(exc, SystemExit):
            # The binary prints the traceback of an uncaught exception to
            # stderr and exits with 1; CliRunner keeps the exception. The last
            # line of the traceback is the model of the binary.
            out["exception"] = first_line(exc)
            out["stderr"] += "".join(traceback.format_exception_only(exc))
        out["files"] = read_tree(folder)
        outer = [load_config_at_path(str(p)) for p in reversed(Path(folder).parents)]
        out["outer_config"] = plain(nested_combine({}, *outer))
        shutil.rmtree(folder)
        return out, calls

    def wrap(original):
        @functools.wraps(original)
        def process(self, *args, **kwargs):
            if tracer.active:
                if tracer.proof_calls is None or tracer.active[-1] != PROOF:
                    return original(self, *args, **kwargs)
                record = {"class": type(self), "fname": kwargs.get("fname")}
                tracer.proof_calls.append(record)
                try:
                    record["result"] = original(self, *args, **kwargs)
                except Exception as exc:
                    record["error"] = exc
                    raise
                return record["result"]
            call: dict = {"kind": "templater"}
            unsupported = []
            if args:
                unsupported.append(f"{len(args)} positional arguments")
            known = {"in_str", "fname", "config", "formatter"}
            if set(kwargs) - known:
                unsupported.append(f"the arguments {sorted(set(kwargs) - known)}")
            if kwargs.get("formatter") is not None:
                unsupported.append("a formatter")
            name = getattr(self, "name", None)
            context = getattr(self, "override_context", None)
            config = kwargs.get("config")
            inputs = {
                "templater": name,
                "class": f"{type(self).__module__}.{type(self).__qualname__}",
                "context": plain(context),
                "in_str": kwargs.get("in_str"),
                "fname": kwargs.get("fname"),
                "config": None
                if config is None
                else getattr(config, "_s7_source", {"method": "<unknown>"}),
                "cwd": tracer.cwd(),
            }
            if type(self) not in (PlaceholderTemplater, PythonTemplater):
                unsupported.append(f"the templater {type(self).__name__}")
            elif not isinstance(inputs["in_str"], str):
                unsupported.append("in_str is not a string")
            else:
                inputs["config_file"], more = config_model(name, context or {}, config)
                unsupported += more
            inputs["unsupported"] = unsupported
            call["inputs"] = inputs
            result = error = None
            tracer.active.append("templater")
            try:
                result = original(self, *args, **kwargs)
            except Exception as exc:
                error = exc
                call["raised"] = first_line(exc)
                if isinstance(exc, SQLTemplaterError):
                    call["error_kind"] = "templater_error"
                elif isinstance(exc, SQLFluffSkipFile):
                    call["error_kind"] = "skip_file"
                else:
                    call["error_kind"] = "other_error"
                raise
            else:
                call["outputs"] = {
                    "templated": str(result[0]),
                    "violations": violation_texts(result[1]),
                }
            finally:
                tracer.active.pop()
                if "text" in inputs.get("config_file", {}) and not unsupported:
                    kind = call.get("error_kind", "returned")
                    files = {
                        s7config.CONFIG_FILE: inputs["config_file"]["text"],
                        TEMPLATER_SQL: inputs["in_str"],
                    }
                    try:
                        runs = [run_case(list(a), files) for a in TEMPLATER_CASES[kind]]
                        call["cases"] = [r for r, _ in runs]
                        call["proof"] = templater_proof(
                            type(self),
                            result,
                            error,
                            inputs["fname"],
                            runs,
                            skip=kind == "skip_file",
                        )
                    except Exception as exc:
                        call["proof_error"] = first_line(exc)
                tracer.bucket()["calls"].append(plain(call))
            return result

        return process

    classes = (RawTemplater, JinjaTemplater, PythonTemplater, PlaceholderTemplater)
    for cls in classes:
        if "process" in cls.__dict__:
            cls.process = wrap(cls.__dict__["process"])
    # A templater method that a test calls outside each traced call: the map
    # does not know it (an untraced call).
    kinds = ("cli", "api", "linter", "linter_string", "helper", "templater", PROOF)
    for cls in classes:
        for name in ("get_context", "slice_file"):
            if name in cls.__dict__:
                what = f"a templater method ({cls.__name__}.{name})"
                setattr(cls, name, tracer.sentinel(kinds, what)(cls.__dict__[name]))


class Recorder:
    """A pytest plugin: sets the node for the trace and records outcomes."""

    def __init__(self, tracer: Tracer) -> None:
        self.tracer = tracer
        self.outcomes: dict[str, str] = {}
        self.errors: dict[str, str] = {}

    def _set(self, node: str) -> None:
        self.tracer.node = node
        os.environ["S7_TRACE_NODE"] = node

    @pytest.hookimpl(wrapper=True)
    def pytest_collection(self, session):
        self._set(COLLECTION)
        try:
            return (yield)
        finally:
            self._set(s7trace.OUTSIDE)

    @pytest.hookimpl(wrapper=True)
    def pytest_runtest_protocol(self, item, nextitem):
        self._set(item.nodeid)
        self.tracer.bucket()
        try:
            return (yield)
        finally:
            self._set(s7trace.OUTSIDE)

    @pytest.hookimpl(tryfirst=True)
    def pytest_runtest_call(self, item) -> None:
        for name in TMP_FIXTURES:
            folder = getattr(item, "funcargs", {}).get(name)
            if folder is not None:
                self.tracer.add_tmp(folder)

    def pytest_runtest_logreport(self, report) -> None:
        if report.when == "call":
            self.outcomes.setdefault(report.nodeid, report.outcome)
        elif report.outcome == "failed":
            # A failed setup or teardown is an error, also after a call that
            # passed: the oracle refuses the outcome "error".
            self.outcomes[report.nodeid] = "error"
        elif report.outcome == "skipped":
            self.outcomes.setdefault(report.nodeid, "skipped")

    def pytest_collectreport(self, report) -> None:
        if report.failed:
            lines = str(report.longrepr).strip().splitlines()
            self.errors[report.nodeid or "<session>"] = lines[-1] if lines else ""


def run(
    root: Path, nodes: list[str], rust: bool, log: Path, templaters: bool = False
) -> dict:
    runs = None
    if rust:
        from sqlfluff_oracle import force_rust

        runs = force_rust()
    tracer = Tracer(root)
    install(tracer)
    if templaters:
        install_templaters(tracer)
    forks: Counter = Counter()

    def audit(event: str, args: tuple) -> None:
        if event in ("os.fork", "os.forkpty"):
            forks[tracer.node] += 1

    paths = [str(TRACE), os.environ.get("PYTHONPATH", "")]
    os.environ.update(
        {
            "PYTHONPATH": os.pathsep.join(p for p in paths if p),
            "PYTHONDONTWRITEBYTECODE": "1",
            "S7_TRACE_LOG": str(log),
            "S7_TRACE_ROOT": str(root),
            "S7_TRACE_MAIN": str(os.getpid()),
            "S7_TRACE_NODE": s7trace.OUTSIDE,
        }
    )
    s7trace.install()
    sys.addaudithook(audit)
    recorder = Recorder(tracer)
    os.chdir(root)
    args = ["-q", "--tb=line", "-p", "no:cacheprovider", "--rootdir", str(root)]
    args += nodes
    saved = os.dup(1)
    os.dup2(2, 1)
    try:
        exit_code = pytest.main(args, plugins=[recorder])
    finally:
        sys.stdout.flush()
        os.dup2(saved, 1)
        os.close(saved)
    os.chdir(REPO_ROOT)

    from sqlfluff.core.config.loader import load_config_at_path

    programs: dict[str, list[str]] = {}
    for line in log.read_text("utf8").splitlines():
        node, kind, *rest = json.loads(line)
        if kind == "program":
            programs.setdefault(node, []).append(f"program ({rest[0]})")
        elif kind == "start":
            programs.setdefault(node, []).append("new Python process")
    for node, count in forks.items():
        programs.setdefault(node, []).extend(["fork"] * count)

    records = tracer.records
    out_nodes = {}
    for node in nodes:
        data = records.pop(node, None)
        if data is None and node not in recorder.outcomes:
            continue
        data = data or {"calls": [], "untraced": [], "forks": 0}
        out_nodes[node] = {
            "outcome": recorder.outcomes.get(node, "not run"),
            "calls": data["calls"],
            "untraced": data["untraced"],
            "processes": programs.pop(node, []),
        }
        if data.get("untraced_linter"):
            out_nodes[node]["untraced_linter"] = data["untraced_linter"]
    outside = {
        "nodes": sorted(records),
        "calls": [c for r in records.values() for c in r["calls"]],
        "untraced": [u for r in records.values() for u in r["untraced"]],
        "processes": sorted(p for v in programs.values() for p in v),
    }
    linter_outside = [u for r in records.values() for u in r["untraced_linter"]]
    if linter_outside:
        outside["untraced_linter"] = linter_outside
    return {
        "kind": KIND,
        "format": FORMAT,
        "sqlfluff": version("sqlfluff"),
        "sqlfluffrs": rust_version(),
        "rust": rust,
        "pytest": pytest.__version__,
        "pytest_exit_code": int(exit_code),
        "root_config": plain(load_config_at_path(str(root))),
        "parse_runs": (
            {name: runs[name] for name in ("RustParser", "Parser")}
            if runs is not None
            else None
        ),
        "collection_errors": dict(sorted(recorder.errors.items())),
        "nodes": out_nodes,
        "outside": outside,
    }


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="trace-nodes")
    parser.add_argument("nodes", nargs="+", help="pytest node ids")
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--rust", action="store_true")
    parser.add_argument(
        "--templaters",
        action="store_true",
        help="also trace the process() calls of the templaters (the S6 scope)",
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=SQLFLUFF_ROOT,
        help="a sqlfluff checkout (default: the submodule; others for the tests)",
    )
    args = parser.parse_args(argv)
    if args.rust and rust_version() is None:
        parser.error("--rust needs the sqlfluff-rs oracle (sqlfluffrs)")
    with tempfile.TemporaryDirectory(prefix="s7-trace-") as tmp:
        log = Path(tmp) / "processes.jsonl"
        log.write_text("")
        data = run(args.root.resolve(), args.nodes, args.rust, log, args.templaters)
    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(json.dumps(data, indent=1) + "\n", "utf8")
    print(
        f"trace: {len(data['nodes'])} nodes,"
        f" outcomes {dict(Counter(n['outcome'] for n in data['nodes'].values()))}",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
