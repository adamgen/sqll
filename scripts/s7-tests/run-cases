#!/usr/bin/env python3
"""Run the S7 black-box cases through the tool binaries and write the report
(docs/decisions/s7-tests-design.md, "Case runner" and "Report").

Run it with the harness environment:

  uv run --frozen --project harness scripts/s7-tests/run-cases
  uv run --frozen --project harness scripts/s7-tests/run-cases \\
      --tool sqlfluff --require-pass sqlfluff --check results/S7-tests/report.json

It loads each case file and the exclusion list (exit code 2 on a format
error), checks the tools (exit code 2 if a tool is not the pin), runs each
case of each node for each tool, writes the report (default
out/s7-tests/report.json), and runs scripts/check-submodule. Exit code 1 if
the submodule changed, if a --require-pass tool did not pass a node, or if
the report is not the --check file.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path

from sqll_harness import tools as tool_checks
from sqll_harness.adapters import ADAPTERS
from sqll_harness.paths import REPO_ROOT
from sqll_harness.s7_tests import caseformat, report, runner

DEFAULT_OUT = REPO_ROOT / "out" / "s7-tests" / "report.json"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--tool",
        action="append",
        choices=runner.TOOLS,
        help="a tool to run (repeat it; default: each tool)",
    )
    parser.add_argument("--jobs", type=int, default=4)
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
    parser.add_argument(
        "--require-pass",
        action="append",
        default=[],
        choices=runner.TOOLS,
        help="exit code 1 if this tool does not pass each node",
    )
    parser.add_argument(
        "--check", type=Path, help="exit code 1 if the report is not this file"
    )
    args = parser.parse_args(argv)
    tools = args.tool or list(runner.TOOLS)
    missing = sorted(set(args.require_pass) - set(tools))
    if missing:
        parser.error(f"--require-pass {missing} needs --tool {missing}")

    try:
        cases = caseformat.load()
    except caseformat.CaseFormatError as exc:
        for line in exc.errors:
            print(f"error: {line}", file=sys.stderr)
        return 2

    bad = [i for i in tool_checks.check(tools) if not i.ok]
    for info in bad:
        for err in info.errors:
            print(f"error: {info.name}: {err}", file=sys.stderr)
    if bad:
        return 2
    adapters = {t: ADAPTERS[t]() for t in tools}
    versions = {t: a.version() for t, a in adapters.items()}

    results = runner.run_nodes(cases.nodes, tools, args.jobs, adapters)
    data = report.build(cases, results, versions)
    report.write(data, args.out)
    print(json.dumps({"counts": data["counts"], "parity": data["parity"]}, indent=1))

    status = 0
    check = subprocess.run(
        [str(REPO_ROOT / "scripts" / "check-submodule"), "after the S7 cases"],
        check=False,
    )
    if check.returncode != 0:
        status = 1
    for tool in args.require_pass:
        bad_nodes = [
            n["id"] for n in data["nodes"] if n["results"][tool]["status"] != "pass"
        ]
        for node_id in bad_nodes:
            print(f"error: {tool} does not pass {node_id}", file=sys.stderr)
        if bad_nodes:
            status = 1
    if args.check is not None:
        recorded = json.loads(args.check.read_text(encoding="utf8"))
        if report.select_tools(recorded, tools) != data:
            print(
                f"error: the report is not {args.check}; compare it with {args.out}",
                file=sys.stderr,
            )
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
