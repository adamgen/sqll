#!/bin/sh
# Run all sqll tests: harness unit tests, then all suites for all tools.
# Arguments go to "sqll-harness run". Output: out/report.json.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

if [ ! -d third_party/sqlfluff/test/fixtures ]; then
    echo "error: sqlfluff submodule is missing. Run: git submodule update --init" >&2
    exit 2
fi

for dir in tools/*/; do
    tool=$(basename "$dir")
    UV_PROJECT_ENVIRONMENT="$root/.tools/$tool" \
        uv sync --quiet --frozen --project "$dir"
done

uv sync --quiet --frozen --project harness
uv run --quiet --frozen --project harness pytest -q harness/tests
uv run --quiet --frozen --project harness sqll-harness run "$@"
