#!/bin/sh
# Run all sqll tests: install the tools, run the harness unit tests, then run
# all suites for all tools. Arguments go to "sqll-harness run".
# Output: out/tools.json and out/report.json.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

if [ ! -d third_party/sqlfluff/test/fixtures ]; then
    echo "error: sqlfluff submodule is missing. Run: git submodule update --init" >&2
    exit 2
fi

SQLL_TOOLS_DIR=${SQLL_TOOLS_DIR:-$root/.tools}
export SQLL_TOOLS_DIR
scripts/setup

uv sync --quiet --frozen --project harness
mkdir -p out
uv run --quiet --frozen --project harness sqll-harness tools > out/tools.json || {
    cat out/tools.json
    exit 1
}

scripts/check-submodule "before the tests"

SQLL_REQUIRE_TOOLS=1 uv run --quiet --frozen --project harness pytest -q harness/tests
status=0
uv run --quiet --frozen --project harness sqll-harness run "$@" || status=$?
scripts/check-submodule "after the run"
exit "$status"
